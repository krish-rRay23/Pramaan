# =============================================================================
# TVS Credit PRAMAAN v3 — Environment Configuration Template
# =============================================================================
# Copy this file to '.env' and fill in your credentials:
# cp .env.example .env

# -----------------------------------------------------------------------------
# 1. Telegram Bot Transport (PRIMARY LIVE DEMO TRANSPORT)
# -----------------------------------------------------------------------------
# Obtain from Telegram @BotFather:
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Optional: default recipient chat ID (can also be auto-registered by sending /start to your bot)
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# 2. CallMeBot WhatsApp Gateway (RETAINED SECONDARY DEMO TRANSPORT)
# -----------------------------------------------------------------------------
# Recipient phone with country code (e.g., +919876543210)
CALLMEBOT_PHONE=

# Free personal API key from https://www.callmebot.com/
CALLMEBOT_API_KEY=

# -----------------------------------------------------------------------------
# 3. Cryptographic Key Configuration (Ed25519 Master Authority)
# -----------------------------------------------------------------------------
# Optional 64-hex char private key seed. Leave blank to use persistent TVS master seed.
# PRAMAAN_ED25519_PRIVATE_KEY=

# -----------------------------------------------------------------------------
# 4. Service Settings
# -----------------------------------------------------------------------------
PORT=8000
